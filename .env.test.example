# Entorno de PRUEBAS LOCAL — ver docs/entorno-local.md
#
# Copiar a `.env.test` (gitignored) para que `npm run test` y `npm run dev` corran contra
# el stack local de Supabase (`npx supabase start`) en vez de la base de datos real.
# `.env.test` tiene prioridad sobre `.env.local` (ver src/test/setup.ts y vitest.config.ts).
#
# Valores exactos: correr `npx supabase status` con el stack local arriba y copiar de ahí
# (son fijos para cualquier stack local de Supabase, no son secretos de producción).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
